# systemd *user* service for osc_vlc_player.py on Raspberry Pi OS Desktop.
#
# The video window has to open on the desktop, so this runs inside your login
# session (not as a system service). It's started by the companion autostart
# entry osc-vlc-player.desktop, which first hands the session's display
# variables (WAYLAND_DISPLAY / DISPLAY) to systemd.
#
# Works for any username: %h below is the home folder of the user running it
# (install it as the user the desktop logs in as, e.g. pi; no editing needed).
#
# Assumes:
#   - script at ~/osc_vlc_player.py, videos in ~/Videos
#   - a venv at ~/venv:
#       python3 -m venv --system-site-packages ~/venv
#       ~/venv/bin/pip install python-osc python-vlc
#   - the desktop logs in automatically at boot
#     (sudo raspi-config -> System Options -> Boot / Auto Login -> Desktop Autologin)
#
# Install (as your normal user, no sudo):
#   mkdir -p ~/.config/systemd/user ~/.config/autostart
#   cp osc-vlc-player.service ~/.config/systemd/user/
#   cp osc-vlc-player.desktop ~/.config/autostart/
#   systemctl --user daemon-reload
#   then reboot
#
# Manage:
#   systemctl --user status osc-vlc-player
#   systemctl --user restart osc-vlc-player
#   systemctl --user stop osc-vlc-player
#   journalctl --user -u osc-vlc-player -f     # live log of OSC/GPIO actions

[Unit]
Description=OSC/GPIO-controlled VLC video player
# Don't give up if it crash-loops (e.g. Videos folder is empty at boot)
StartLimitIntervalSec=0

[Service]
Type=simple
# lgpio (gpiozero's backend) needs a writable working directory
WorkingDirectory=%h
Environment=PYTHONUNBUFFERED=1
# If the video window doesn't appear or won't go fullscreen under Wayland,
# uncomment this to make VLC use XWayland instead:
#UnsetEnvironment=WAYLAND_DISPLAY
ExecStart=%h/venv/bin/python %h/osc_vlc_player.py %h/Videos
Restart=on-failure
RestartSec=5
